+        # This flow has no router (DetailedRouting/RCX are substituted out), so a
+        # top-level port connects to its driver(s) ONLY by geometric overlap. Every
+        # tile is inset from the die edge by FABULOUS_HALO_SPACING, so a BPin placed
+        # on the die edge floats and the net is split at extraction ("Top level cell
+        # failed pin matching"). Place a pin shape directly over EVERY iterm of the
+        # net, on that terminal's own layer: single-driver ports (e.g. FrameData)
+        # get one shape; fan-out globals (e.g. UserCLK -> all column terminators)
+        # get one per terminal so they all unify under this port at extraction.
+        for iterm in iterms:
+            ibox: odbRectLike = iterm.getBBox()
+
+            iterm_layer = None
+            for mpin in iterm.getMTerm().getMPins():
+                geometry = mpin.getGeometry()
+                if geometry:
+                    iterm_layer = geometry[0].getTechLayer()
+                    break
+            if iterm_layer is None:
+                iterm_layer = h_layer
+
+            # Cover the iterm bbox (clamped inside the die) on the iterm's layer.
+            x_lo = int(max(llx, min(ibox.xMin(), urx - 1)))
+            y_lo = int(max(lly, min(ibox.yMin(), ury - 1)))
+            x_hi = int(min(urx, max(ibox.xMax(), x_lo + 1)))
+            y_hi = int(min(ury, max(ibox.yMax(), y_lo + 1)))
