# Local experiment workspaces — tool checkouts, runs, and PDK/build artifacts.
# These are clones/outputs and must never be committed (see CLAUDE.md hygiene rules).
/FABulous_work/sky130-fabulous-testchip/
/FABulous_work/fabulous-v2/
/FABulous_work/**/runs/
/FABulous_work/**/macro/

# Nix build result symlinks
result
result-*

# Bootstrap experiment logs + local scratch scripts (canonical commands live in docs/)
/FABulous_work/*.log
/FABulous_work/*.mem
/FABulous_work/*_report.txt
/FABulous_work/_logs/
/FABulous_work/*.sh

# PDK store (ciel/volare)
.ciel/

# Modern ChipFoundry Caravel harness (clean-room external dep; cloned via Makefile)
/Librelane_work/caravel_user_project/

# Standalone LibreLane hardening runs for individual stochastic blocks
# (Stochastic_Blocks/librelane/<block>/config.yaml is the tracked recipe;
# each run regenerates hundreds of MB of intermediate stage logs/databases
# under runs/, only the final GDS/reports matter and those are recorded
# in commit messages / wiki writeups, not committed wholesale here).
/Stochastic_Blocks/librelane/*/runs/
